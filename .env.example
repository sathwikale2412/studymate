# Browser: Supabase auth + the login/question log.
# Use the anon public key only — it is RLS-guarded and already ends up in the bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server: optional hosted language model for grounded answers.
# Leave these unset and /answer returns the retrieved passages instead of prose.
# Any OpenAI-compatible endpoint works: OpenRouter, Hugging Face Inference Providers,
# a self-hosted vLLM. Never commit a real key.
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=google/gemini-2.5-flash

# Only needed if you run the API on a different origin than the site.
# VITE_API_BASE=/api
